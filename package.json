{
  "name": "dsh-composer-send-key",
  "version": "1.0.0",
  "description": "Switch the DeepSeek Harness message box send shortcut between default (Enter sends) and edit-friendly (Shift+Enter sends) modes.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "README.md", "icon.svg"],
  "license": "MIT",
  "author": "Licheung228",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Licheung228/dsh-composer-send-key.git"
  },
  "homepage": "https://github.com/Licheung228/dsh-composer-send-key#readme",
  "bugs": "https://github.com/Licheung228/dsh-composer-send-key/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "composer",
    "keyboard-shortcuts",
    "enter",
    "shift-enter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
