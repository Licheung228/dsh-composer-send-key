{
  "name": "dsh-composer-send-key",
  "version": "1.1.0",
  "description": "Switch the DeepSeek Harness message composer send shortcut: Enter sends, or edit-friendly mode where Enter inserts a new line and Shift+Enter or Ctrl+Enter sends.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "locale/*.json", "README.md", "README.zh.md", "icon.svg"],
  "scripts": {
    "build": "pnpm run typecheck && pnpm run build:host && pnpm run build:client",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:host": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@deepseek-ai/schemastery --outfile=lib/index.js",
    "build:client": "esbuild src/client/index.ts --bundle --platform=browser --format=iife --target=es2022 --outfile=lib/client.js",
    "prepublishOnly": "pnpm run build"
  },
  "license": "MIT",
  "author": "Licheung228",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Licheung228/dsh-composer-send-key.git"
  },
  "homepage": "https://github.com/Licheung228/dsh-composer-send-key#readme",
  "bugs": {
    "url": "https://github.com/Licheung228/dsh-composer-send-key/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "composer",
    "keyboard-shortcuts",
    "enter",
    "shift-enter",
    "ctrl-enter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
